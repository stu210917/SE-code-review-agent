# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会提交到仓库。
#
# 留空 CR_API_KEY 时，程序会自动进入「离线 Mock 模式」：
# 不需要联网、不需要密钥，直接用 AST 静态分析规则引擎产出审查结论。

# ---- LLM 接入（OpenAI 兼容接口）----
CR_BASE_URL=https://api.deepseek.com/v1
CR_API_KEY=
CR_MODEL=deepseek-chat
CR_TEMPERATURE=0.2
CR_TIMEOUT=60

# ---- 常用服务商参考 ----
# OpenAI    : CR_BASE_URL=https://api.openai.com/v1          CR_MODEL=gpt-4o-mini
# DeepSeek  : CR_BASE_URL=https://api.deepseek.com/v1        CR_MODEL=deepseek-chat
# 通义千问   : CR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   CR_MODEL=qwen-plus
# 智谱 GLM  : CR_BASE_URL=https://open.bigmodel.cn/api/paas/v4                 CR_MODEL=glm-4-plus
# Kimi      : CR_BASE_URL=https://api.moonshot.cn/v1         CR_MODEL=moonshot-v1-8k
# 本地 Ollama: CR_BASE_URL=http://localhost:11434/v1         CR_MODEL=qwen2.5-coder:7b

# ---- Agent 行为 ----
CR_MAX_STEPS=12
CR_MEMORY_TOKEN_BUDGET=6000
CR_MAX_RETRIES=3

# ---- 安全开关：是否允许真正执行被审查的代码（默认关闭）----
CR_ALLOW_EXEC=false
